-- إنشاء نافذة رئيسية
function Xenolib.new(title, size, autoHide)
    local self = setmetatable({}, Xenolib)
    
    self.Title = title or "Xenolib UI"
    self.Size = size or UDim2.new(0, 400, 0, 500)
    self.AutoHide = autoHide or false
    self.Tabs = {}
    self.CurrentTab = nil
    self.Visible = false
    self.Theme = "Dark"
    
    self:CreateMainUI()
    self:SetupAnimations()
    self:SetupDragging()
    
    if self.AutoHide then
        self:Hide()
    end
    
    return self
end

