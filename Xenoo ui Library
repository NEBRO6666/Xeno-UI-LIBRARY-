-- إضافة زر إلى القسم
function Xenolib.Section:AddButton(buttonName, callback)
    local button = Instance.new("TextButton")
    button.Name = buttonName .. "Button"
    button.Size = UDim2.new(1, 0, 0, 30)
    button.BackgroundColor3 = Xenolib.Colors.Primary
    button.Text = buttonName
    button.TextColor3 = Xenolib.Colors.Text
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.Parent = self.Content
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 5)
    buttonCorner.Parent = button
    
    -- أنيميشن الضغط
    button.MouseButton1Down:Connect(function()
        local tween = TweenService:Create(
            button,
            TweenInfo.new(0.1, Xenolib.Animations.EaseStyles.Quad, Xenolib.Animations.EaseDirections.Out),
            {BackgroundColor3 = Xenolib.Colors.Accent}
        )
        tween:Play()
    end)
    
    button.MouseButton1Up:Connect(function()
        local tween = TweenService:Create(
            button,
            TweenInfo.new(0.1, Xenolib.Animations.EaseStyles.Quad, Xenolib.Animations.EaseDirections.Out),
            {BackgroundColor3 = Xenolib.Colors.Primary}
        )
        tween:Play()
        
        if callback then
            callback()
        end
    end)
    
    return button
end

