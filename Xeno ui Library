            local LabelPadding = Instance.new("UIPadding")
            LabelPadding.Name = "LabelPadding"
            LabelPadding.PaddingLeft = UDim.new(0, 10)
            LabelPadding.Parent = LabelFrame
            
            return Label
        end
        
        -- Store tab references
        Tab.Button = TabButton
        Tab.Content = TabContent
        table.insert(Window.Tabs, Tab)
        
        return Tab
    end
    
    -- Auto-resize content container when tabs are added
    TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabContainer.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y + 10)
    end)
    
    -- Auto-resize tab content when elements are added
    for _, tab in pairs(Window.Tabs) do
        tab.Content:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tab.Content.CanvasSize = UDim2.new(0, 0, 0, tab.Content.UIListLayout.AbsoluteContentSize.Y + 20)
        end)
    end
    
    return Window
end

return Xenolib
