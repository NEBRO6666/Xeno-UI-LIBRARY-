-- إضافة منزلق إلى القسم
function Xenolib.Section:AddSlider(name, minValue, maxValue, defaultValue, callback)
    local slider = {}
    slider.Name = name or "Slider"
    slider.Min = minValue or 0
    slider.Max = maxValue or 100
    slider.Value = defaultValue or minValue
    
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Name = name .. "SliderFrame"
    sliderFrame.Size = UDim2.new(1, 0, 0, 50)
    sliderFrame.BackgroundTransparency = 1
    sliderFrame.Parent = self.Content
    
    local sliderTitle = Instance.new("TextLabel")
    sliderTitle.Name = "Title"
    sliderTitle.Size = UDim2.new(1, 0, 0, 15)
    sliderTitle.BackgroundTransparency = 1
    sliderTitle.Text = name .. ": " .. slider.Value
    sliderTitle.TextColor3 = Xenolib.Colors.Text
    sliderTitle.TextXAlignment = Enum.TextXAlignment.Left
    sliderTitle.Font = Enum.Font.Gotham
    sliderTitle.TextSize = 12
    sliderTitle.Parent = sliderFrame
    
    local sliderBarFrame = Instance.new("Frame")
    sliderBarFrame.Name = "SliderBarFrame"
    sliderBarFrame.Size = UDim2.new(1, 0, 0, 10)
    sliderBarFrame.Position = UDim2.new(0, 0, 0, 20)
    sliderBarFrame.BackgroundColor3 = Xenolib.Colors.Secondary
    sliderBarFrame.Parent = sliderFrame
    
    local sliderBarCorner = Instance.new("UICorner")
    sliderBarCorner.CornerRadius = UDim.new(1, 0)
    sliderBarCorner.Parent = sliderBarFrame
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "SliderFill"
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    sliderFill.BackgroundColor3 = Xenolib.Colors.Primary
    sliderFill.Parent = sliderBarFrame
    
    local sliderFillCorner = Instance.new("UICorner")
    sliderFillCorner.CornerRadius = UDim.new(1, 0)
    sliderFillCorner.Parent = sliderFill
    
    local sliderButton = Instance.new("TextButton")
    sliderButton.Name = "SliderButton"
    sliderButton.Size = UDim2.new(0, 20, 0, 20)
    sliderButton.Position = UDim2.new(0, 0, 0, 15)
    sliderButton.BackgroundColor3 = Xenolib.Colors.Accent
    sliderButton.Text = ""
    sliderButton.Parent = sliderFrame
    
    local sliderButtonCorner = Instance.new("UICorner")
    sliderButtonCorner.CornerRadius = UDim.new(1, 0)
    sliderButtonCorner.Parent = sliderButton
    
    -- إعداد أحداث السحب
    local dragging = false
    
    local function updateSlider(input)
        local relativeX = (input.Position.X - sliderBarFrame.AbsolutePosition.X) / sliderBarFrame.AbsoluteSize.X
        local value = math.floor((slider.Max - slider.Min) * math.clamp(relativeX, 0, 1) + slider.Min)
        
        slider.Value = value
        sliderTitle.Text = name .. ": " .. value
        
        local fillSize = UDim2.new(math.clamp(relativeX, 0, 1), 0, 1, 0)
        local tween = TweenService:Create(
            sliderFill,
            TweenInfo.new(0.1, Xenolib.Animations.EaseStyles.Quad, Xenolib.Animations.EaseDirections.Out),
            {Size = fillSize}
        )
        tween:Play()
        
        sliderButton.Position = UDim2.new(math.clamp(relativeX, 0, 1), -10, 0, 15)
        
        if callback then
            callback(value)
        end
    end
    
    sliderButton.MouseButton1Down:Connect(function()
        dragging = true
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    sliderBarFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            updateSlider(input)
        end
    end)
    
    -- تعيين القيمة الافتراضية
    local defaultRatio = (slider.Value - slider.Min) / (slider.Max - slider.Min)
    sliderFill.Size = UDim2.new(defaultRatio, 0, 1, 0)
    sliderButton.Position = UDim2.new(defaultRatio, -10, 0, 15)
    
    return slider
end

